// Тест основных возможностей Foenu-x

// Числа и арифметика
Foenu-x 10 + 5;
Foenu-x 10 - 5;
Foenu-x 10 * 5;
Foenu-x 10 / 4;
Foenu-x 10 / 2;

// Текст и склейка
Foenu-x text-(#Число: #) + 42;

// Логика
if 1 = 1 and 2 < 3 then begin
  Foenu-x text-(#логика ок#);
end;

if not false then begin
  Foenu-x text-(#not ок#);
end;

// Сравнение текста
if #аб# < #ба# then begin
  Foenu-x text-(#сравнение текста ок#);
end;

// Цикл while + :=
var i be 0;
var сумма be 0;
while i < 5 begin
  сумма := сумма + i;
  i := i + 1;
end;
Foenu-x сумма;

// Рекурсия: факториал
function факториал(n) begin
  if n <= 1 then begin
    return 1;
  end;
  return n * факториал(n - 1);
end;
Foenu-x факториал(5);

// Функция без return
function пустая() begin
  Foenu-x text-(#внутри функции#);
end;
Foenu-x пустая();

// Вложенные вызовы
function удвоить(x) begin
  return x * 2;
end;
Foenu-x удвоить(удвоить(3) + 1);

// Скобки
Foenu-x (2 + 3) * 4;

// else if
var оценка be 4;
if оценка >= 5 then begin
  Foenu-x text-(#отлично#);
end else if оценка >= 4 then begin
  Foenu-x text-(#хорошо#);
end else begin
  Foenu-x text-(#надо стараться#);
end;

// ===== Новое в 26.10.10 =====

// Массивы
var список be [10, 20, 30];
Foenu-x список[0];
список[1] := 99;
push(список, 40);
Foenu-x список;
Foenu-x len(список);
Foenu-x len(#привет#);
Foenu-x список + [50, 60];

// for
var итог2 be 0;
for i := 1 to 5 begin
  итог2 := итог2 + i;
end;
Foenu-x итог2;

for i := 3 downto 1 begin
  Foenu-x i;
end;

// break
var x2 be 0;
while true begin
  x2 := x2 + 1;
  if x2 > 3 then begin
    break;
  end;
end;
Foenu-x x2;

// % и встроенные
Foenu-x 17 % 5;
Foenu-x upper(#abc#);
Foenu-x lower(#ABC#);
Foenu-x abs(0 - 7);
Foenu-x min(3, 8);
Foenu-x max(3, 8);
Foenu-x num(#42#) + 1;
Foenu-x pop([1, 2, 3]);

// индекс текста
Foenu-x #привет# [0];
