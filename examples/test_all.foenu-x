// Тест основных возможностей Foenu-x

// Числа и арифметика
Foenu-x 10 + 5;
Foenu-x 10 - 5;
Foenu-x 10 * 5;
Foenu-x 10 / 4;
Foenu-x 10 / 2;

// Текст и склейка
Foenu-x text-(#Число: #) + 42;

// Логика
if 1 = 1 and 2 < 3 then begin
  Foenu-x text-(#логика ок#);
end;

if not false then begin
  Foenu-x text-(#not ок#);
end;

// Сравнение текста
if #аб# < #ба# then begin
  Foenu-x text-(#сравнение текста ок#);
end;

// Цикл while + :=
var i be 0;
var сумма be 0;
while i < 5 begin
  сумма := сумма + i;
  i := i + 1;
end;
Foenu-x сумма;

// Рекурсия: факториал
function факториал(n) begin
  if n <= 1 then begin
    return 1;
  end;
  return n * факториал(n - 1);
end;
Foenu-x факториал(5);

// Функция без return
function пустая() begin
  Foenu-x text-(#внутри функции#);
end;
Foenu-x пустая();

// Вложенные вызовы
function удвоить(x) begin
  return x * 2;
end;
Foenu-x удвоить(удвоить(3) + 1);

// Скобки
Foenu-x (2 + 3) * 4;

// else if
var оценка be 4;
if оценка >= 5 then begin
  Foenu-x text-(#отлично#);
end else if оценка >= 4 then begin
  Foenu-x text-(#хорошо#);
end else begin
  Foenu-x text-(#надо стараться#);
end;
