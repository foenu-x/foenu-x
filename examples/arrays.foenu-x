// Массивы в Foenu-x (новое в 26.10.10)
var числа be [10, 20, 30, 40, 50];

Foenu-x числа;
Foenu-x числа[0];
Foenu-x числа[4];

числа[1] := 99;
Foenu-x числа;

push(числа, 60);
push(числа, 70);
Foenu-x числа;
Foenu-x len(числа);

Foenu-x pop(числа);
Foenu-x числа;

// Сумма элементов через for
var сумма be 0;
for i := 0 to len(числа) - 1 begin
  сумма := сумма + числа[i];
end;
Foenu-x text-(#Сумма элементов: #) + сумма;

// Массив текстов
var имена be [#Анна#, #Борис#, #Вера#];
for i := 0 to 2 begin
  Foenu-x text-(#Имя: #) + имена[i];
end;
