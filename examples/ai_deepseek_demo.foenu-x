// Программа на языке Foenu-x
// Демонстрация основных конструкций
// Автор: DeepSeek (нейросеть, обученная на корпусе foenu-x-corpus.md)

// Объявление переменных
var имя be #Foenu-x#;
var счётчик be 5;
var сумма be 0;

// Вывод приветствия
Foenu-x text-(#Привет, #) + имя + text-(#!#);

// Цикл: накопление суммы чисел от 1 до 5
while счётчик > 0 begin
  сумма := сумма + счётчик;
  счётчик := счётчик - 1;
end;

// Вывод результата
Foenu-x text-(#Сумма чисел от 1 до 5: #) + сумма;

// Условие
if сумма > 10 then begin
  Foenu-x text-(#Сумма больше 10#);
end else begin
  Foenu-x text-(#Сумма не больше 10#);
end;

// Функция: удвоение числа
function удвоить(x) begin
  return x * 2;
end;

// Вызов функции
var результат be удвоить(7);
Foenu-x text-(#Удвоенная семёрка: #) + результат;

// Рекурсивная функция: факториал
function факториал(n) begin
  if n <= 1 then begin
    return 1;
  end;
  return n * факториал(n - 1);
end;

Foenu-x text-(#Факториал 5: #) + факториал(5);
