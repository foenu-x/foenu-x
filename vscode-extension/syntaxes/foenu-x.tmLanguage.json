{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Foenu-x",
  "scopeName": "source.foenu-x",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.foenu-x",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.other.text.foenu-x",
          "begin": "#",
          "end": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.foenu-x" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.foenu-x" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.foenu-x",
          "match": "(?<![\\w-])(Foenu-x|text-|CMD)(?![\\w-])"
        },
        {
          "name": "keyword.other.foenu-x",
          "match": "\\b(var|be|if|then|else|while|begin|end|function|return)\\b"
        },
        {
          "name": "keyword.operator.logical.foenu-x",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.foenu-x",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.nil.foenu-x",
          "match": "\\bnil\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.foenu-x",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.foenu-x",
          "match": "\\b[A-Za-z_\\u0400-\\u04FF][A-Za-z0-9_\\u0400-\\u04FF]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.foenu-x",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.foenu-x",
          "match": "==|!=|>=|<=|[><=]"
        },
        {
          "name": "keyword.operator.arithmetic.foenu-x",
          "match": "[+\\-*/]"
        },
        {
          "name": "punctuation.foenu-x",
          "match": "[();,]"
        }
      ]
    }
  }
}
