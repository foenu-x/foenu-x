{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["begin", "end"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "#", "close": "#" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["#", "#"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\bbegin\\s*$",
    "decreaseIndentPattern": "^\\s*end\\b"
  }
}
